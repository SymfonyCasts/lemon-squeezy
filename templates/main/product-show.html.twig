{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block content %}

<div class="flex justify-center mt-20">
    
        <img class="max-h-[200px]" src="{{ asset('images/'~product.slug~'.png') }}" alt="{{ product.name }}">
        <div class="ml-10">
            <a href="{{ path('app_homepage') }}" class="uppercase poppins-bold hover:text-[#370E12] hover:cursor-pointer">< back</a>
            <h1 class="chewy-regular text-[40px]">{{ product.name }}</h1>
            <p class="chewy-regular text-lg">{{ product.price|price_format }}</p>
            <p class="w-[500px] py-5">{{ product.description }}</p>

            <form class="max-w-xs mx-auto" action="{{ path('app_cart_product_add', {'slug': product.slug}) }}" method="post">
                <label for="quantity-input" class="hidden">Choose quantity:</label>
                <div class="relative flex items-center max-w-[8rem]">
                    <button type="button" id="decrement-button" data-input-counter-decrement="quantity-input" class="bg-white hover:bg-gray-200 border border-gray-300 rounded-s-lg p-3 h-11 focus:ring-gray-100 focus:ring-2 focus:outline-none">
                        <svg class="w-3 h-3 text-gray-900 " aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 2">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h16"/>
                        </svg>
                    </button>
                    <input type="text" id="quantity-input" data-input-counter aria-describedby="lemonade-quantity" class="bg-white border border-x-0 border-gray-300 h-11 text-center text-gray-900 text-sm focus:ring-blue-500 focus:border-blue-500 block w-full py-2.5" placeholder="1" required />
                    <button type="button" id="increment-button" data-input-counter-increment="quantity-input" class="bg-white  hover:bg-gray-200 border border-gray-300 rounded-e-lg p-3 h-11 focus:ring-gray-100 focus:ring-2 focus:outline-none">
                        <svg class="w-3 h-3 text-gray-900" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 18">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 1v16M1 9h16"/>
                        </svg>
                    </button>
                </div>
                <button class="bg-yellow-300" type="submit">Add to cart</button>
            </form>
        </div>
</div>
{% endblock %}

